# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# o exemplo e versionado de proposito: e o contrato de quais variaveis existem.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# banco local de desenvolvimento (backend de arquivo do store)
.tailor-dev/

# artefatos efemeros da skill impeccable (paginas de decisao, cache do hook)
.impeccable/questions/
.impeccable/live/
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# Netlify — estado local do link de site (contém só o site id, mas é ambiente)
.netlify/

# Gerado pelo edge-bundler do Netlify durante o deploy
deno.lock
