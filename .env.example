# ---------------------------------------------------------------------------
# Tailor — variáveis de ambiente
# Copie para .env.local. Nenhum valor real entra neste arquivo nem no git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MODELO DE TEXTO (geração do diagnóstico e extração estruturada)
# ---------------------------------------------------------------------------
# Qual provedor atende. Vazio ou inválido = anthropic. A rota não sabe quem
# atendeu: trocar de fornecedor é mudar esta linha, não fazer deploy — mesmo
# padrão de TRANSCRICAO_PROVEDOR.
# Válidos: anthropic | gemini
LLM_PROVEDOR=anthropic

# Claude API. A API paga da Anthropic (Console) é conta SEPARADA da
# assinatura Max/Pro do claude.ai e do Claude Code — uma não cobre a outra.
ANTHROPIC_API_KEY=

# Modelos, com default econômico (ver tailor-spec.md §3 e §4).
# Sem estas variáveis o app usa claude-haiku-4-5 e claude-sonnet-5.
CLAUDE_MODEL_ANALISE=claude-haiku-4-5
CLAUDE_MODEL_GERACAO=claude-sonnet-5

# Gemini — o caminho gratuito (decisão do Willian, 15/08/2026): Google AI
# Studio tem tier grátis indefinido para Flash/Flash-Lite, sem cartão. Chave
# em aistudio.google.com/apikey. Sem GEMINI_MODEL_*, usa
# gemini-flash-lite-latest (análise) e gemini-flash-latest (diagnóstico).
GEMINI_API_KEY=
GEMINI_MODEL_ANALISE=gemini-flash-lite-latest
GEMINI_MODEL_GERACAO=gemini-flash-latest

# Supabase. Sem estas duas, o app cai no backend de arquivo (.tailor-dev/)
# em desenvolvimento e falha em produção, de propósito.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# ---------------------------------------------------------------------------
# TRANSCRIÇÃO (F6 — modo áudio)
# ---------------------------------------------------------------------------
# Qual provedor atende. Vazio ou inválido = groq. A rota não sabe quem atendeu:
# trocar de fornecedor é mudar esta linha, não fazer deploy.
# Válidos: groq | deepgram
TRANSCRICAO_PROVEDOR=groq

# Groq Whisper. Free tier generoso; modelo default whisper-large-v3-turbo.
GROQ_API_KEY=
GROQ_MODELO_TRANSCRICAO=

# Deepgram. Melhor qualidade em pt-BR; modelo default nova-2.
DEEPGRAM_API_KEY=
DEEPGRAM_MODELO_TRANSCRICAO=

# URL pública, usada para montar o link da proposta em mensagens.
APP_URL=http://localhost:3000

# Upstash Redis — rate limit durável, compartilhado entre instâncias.
# Sem estas duas, cada rota cai no balde por processo (limite × instâncias,
# não um teto real). Crie um banco grátis em upstash.com e cole a REST URL
# e o token daqui — nunca a senha de conexão Redis clássica.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Teto GLOBAL por hora das rotas que gastam dinheiro — conta a rota inteira,
# sem olhar quem chamou, então nenhuma falsificação de origem o contorna.
# Só funciona com Upstash configurado acima. Vazio usa o default do código
# (proposal 120/h, analyze 200/h, transcribe 300/h, whatsapp 300/h). Suba se um lançamento
# real esbarrar — é rede de proteção de custo, não modelagem de tráfego.
TETO_GLOBAL_PROPOSAL_POR_HORA=
TETO_GLOBAL_ANALYZE_POR_HORA=
TETO_GLOBAL_TRANSCRIBE_POR_HORA=
TETO_GLOBAL_WHATSAPP_POR_HORA=

# WhatsApp da Renilza em E.164 sem o '+'. Vazio usa o oficial (5511950291364);
# preencha só para apontar para um número de teste.
NEXT_PUBLIC_WHATSAPP=

# ---------------------------------------------------------------------------
# WHATSAPP CLOUD API (acionamento direto — a mensagem dela cria o lead sozinha)
# ---------------------------------------------------------------------------
# String que VOCÊ inventa e cola idêntica no App Dashboard da Meta, no campo
# "Verify token" da assinatura de webhook. SEM ELA o GET de verificação
# responde 503 e a Meta nunca consegue assinar o webhook.
WHATSAPP_VERIFY_TOKEN=

# App Secret do app Meta (Configurações › Básico). É com ele que a assinatura
# X-Hub-Signature-256 é conferida. SEM ELE a rota /api/webhooks/whatsapp recusa
# todo POST com 503, de propósito: aberta, qualquer um criaria lead e token de
# confirmação em nome de qualquer número.
WHATSAPP_APP_SECRET=

# Token permanente de System User (permissões whatsapp_business_messaging,
# whatsapp_business_management, business_management). O token do "Get Started"
# expira em horas e não serve. Sem ele o webhook continua RECEBENDO e gravando
# tudo — só não consegue baixar o áudio nem responder; o link fica no banco e
# o envio vira log.
WHATSAPP_TOKEN=

# Phone Number ID do número comercial (não é o telefone, é o id numérico do
# painel). Sem ele não há envio nem download de mídia, e o webhook ignora
# qualquer payload cujo metadata.phone_number_id não seja este.
WHATSAPP_PHONE_NUMBER_ID=

# Versão da Graph API, fixada de propósito. Vazio ou fora do formato vXX.Y usa
# v26.0 (lançada em 29/07/2026). Nunca chame a Graph sem versão.
WHATSAPP_GRAPH_VERSAO=v26.0

# Template aprovado, usado SÓ quando a resposta sai fora da janela de 24h
# (reentrega atrasada, reprocessamento manual). Precisa de dois parâmetros de
# corpo, nesta ordem: {{1}} primeiro nome, {{2}} link de confirmação. Vazio =
# fora da janela nada é enviado e fica um console.error com o link — nenhum
# texto livre é tentado, porque a Meta recusaria e a conta pagaria em qualidade.
WHATSAPP_TEMPLATE_CONFIRMACAO=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ---------------------------------------------------------------------------
# CHECKOUT
# ---------------------------------------------------------------------------

# Asaas — gateway do high-ticket (Dossiê, Prisma).
# Sem ASAAS_API_KEY o checkout responde "mock" e a página mostra o aviso de
# demonstração. Rode em sandbox antes de apontar para producao.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=

# Token do webhook — SEM ELE a rota /api/webhooks/asaas recusa tudo com 503,
# de propósito: aberta, qualquer um marcaria qualquer lead como pago. Gere uma
# string aleatória longa, cole aqui E no campo de token do webhook no painel
# do Asaas (Integrações › Webhooks). Os dois têm de ser idênticos.
ASAAS_WEBHOOK_TOKEN=

# Preços EM CENTAVOS. Sem eles o produto continua ◆ e o checkout fica dormente.
# A MESMA env alimenta o preço exibido na proposta e o link de pagamento —
# mudar aqui muda os dois, não existe segundo lugar para atualizar.
# Ex.: 350000 = R$ 3.500,00
PRECO_DOSSIE_CENTAVOS=
PRECO_PRISMA_ESSENCIAL_CENTAVOS=
PRECO_PRISMA_COMPLETO_CENTAVOS=
PRECO_JORNADA_CENTAVOS=

# Nomes de exibição, opcionais. Vazio usa o catálogo de src/content/config.ts.
# Servem para testar um rebatismo sem tocar em código.
PRODUTO_DOSSIE_NOME=
PRODUTO_PRISMA_ESSENCIAL_NOME=
PRODUTO_PRISMA_COMPLETO_NOME=
PRODUTO_JORNADA_NOME=

# Máximo de parcelas no cartão (1 desliga o parcelado). Padrão 12.
CHECKOUT_MAX_PARCELAS=12

# Hotmart — cross-sell dos níveis 0–2 no fim da proposta.
# Cole o link de checkout de cada produto. Vazio esconde o bloco inteiro.
HOTMART_LINK_CIRCULO=
HOTMART_LINK_JORNADA=
